@import "../../styles/workloads.wxss";

.news-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.masthead {
  font-size: 44rpx;
  font-weight: 700;
}

.menu-button {
  margin-top: 0;
}

.news-menu {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.section-button {
  margin: 0;
  background: #f1f3f8;
  color: #344462;
}

.section-button.selected {
  background: #2457c5;
  color: white;
}

.section-header {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 14rpx;
  background: linear-gradient(125deg, #1b3559, #365c7d);
  color: white;
}

.section-kicker {
  color: #d0e8ff;
  font-size: 20rpx;
  letter-spacing: 3rpx;
}

.section-title {
  margin-top: 6rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.story {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e1e6ee;
}

.story-index {
  min-width: 42rpx;
  color: #53637a;
  font-weight: 700;
}

.story-title,
.article-title {
  font-weight: 700;
}

.article-title,
.article-body {
  margin-top: 20rpx;
}
