page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: #f3f5f8;
  color: #172338;
  font-size: 28rpx;
}

.screen {
  max-width: 900rpx;
  margin: 0 auto;
  padding: 36rpx 28rpx 64rpx;
}

.intro {
  padding: 12rpx 4rpx 28rpx;
}

.eyebrow,
.title,
.description {
  display: block;
}

.eyebrow {
  color: #2457c5;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin: 12rpx 0;
  font-size: 56rpx;
  font-weight: 700;
}

.description,
.hint {
  color: #53637a;
  line-height: 1.5;
}

.hint {
  margin: 6rpx 0;
  font-size: 24rpx;
}

.panel {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e1e6ee;
  border-radius: 20rpx;
  background: #fff;
}

.heading {
  font-size: 32rpx;
  font-weight: 700;
}

.status {
  margin: 16rpx 0;
  color: #2457c5;
}

.button {
  display: block;
  margin: 20rpx 0 0;
  padding: 0 22rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 76rpx;
}

.button::after {
  border: 0;
}

.button-primary {
  background: #2457c5;
  color: #fff;
}

.button-secondary {
  background: #ecf2ff;
  color: #1b4bac;
}

.result {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #e1e6ee;
}

.result-heading {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-weight: 700;
}

.phase-time {
  flex: none;
  color: #2457c5;
}

.actions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 14rpx 0;
}

.actions .button {
  margin: 0;
}

.benchmark-scroll {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
}

.renderer-navigation {
  flex: none;
  background: #f3f5f8;
}

.renderer-navigation-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 48px;
  padding: 0 104px 0 12px;
}

.home-button {
  flex: none;
  margin: 0 12px 0 0;
  padding: 0 8px;
  background: transparent;
  color: #2457c5;
  font-size: 24rpx;
  line-height: 36px;
}

.home-button::after {
  border: 0;
}

.renderer-navigation-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 700;
}

.renderer-controls {
  padding-bottom: 20rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #d7dfeb;
}

.renderer-options,
.renderer-option {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.renderer-options {
  gap: 28rpx;
}

.renderer-warning {
  color: #9a304e;
  font-size: 24rpx;
}
